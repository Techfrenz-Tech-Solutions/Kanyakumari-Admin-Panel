# Backend origin. Keep environment-specific hosts out of source code.
# Leave empty for same-origin /api proxying in production.
VITE_API_BASE_URL=

# Local dev proxy target used by `npm run dev` for same-origin /api and /uploads.
# Leave unset to use the deployed backend, or set to http://127.0.0.1:28112
# when running the backend locally.
VITE_DEV_API_PROXY_TARGET=

# Default JSON request timeout. Uploads can override this per request in Step 3.
VITE_API_TIMEOUT_MS=15000
